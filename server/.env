NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://certi:certipass@localhost:5432/certiverify
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
QR_HMAC_SECRET=supersecret_hmac_key_with_min_32_chars_123456
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── JWT (RSA key pair for RS256 signing) ───
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ACCESS_EXPIRY=15m

# ─── Security ───
BCRYPT_ROUNDS=12
QR_HMAC_SECRET=change-this-to-a-64-char-hex-secret
ACCESS_KEY_SECRET=change-this-to-another-64-char-hex-secret
